{
  "name": "clause-review-console",
  "version": "1.0.0",
  "private": true,
  "description": "条文变更审阅台 — 粘贴规范前后版本，按段落比对差异并创建审阅批注，后续版本通过文本锚点自动迁移未解决批注",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
